<UserControl x:Class="NeteaseToolbox.Wpf.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1000"
             Background="Transparent">
    <UserControl.Resources>
        <!-- 玻璃卡片：底色/描边由主窗口按玻璃开关与明暗主题动态切换 -->
        <Style x:Key="GlassCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ToolboxGlassCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ToolboxGlassCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <!-- 卡片顶部柔光：不拦截鼠标，叠加在玻璃底色之上 -->
        <Style x:Key="GlassCardGlowStyle" TargetType="Border">
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#30FFFFFF" Offset="0" />
                        <GradientStop Color="#0CFFFFFF" Offset="0.26" />
                        <GradientStop Color="#00FFFFFF" Offset="0.55" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>

        <Style x:Key="SectionHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="LineHeight" Value="19" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
        </Style>

        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,20,28,32">
            <!-- 标题卡 -->
            <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,20">
                <Grid>
                    <Border Style="{StaticResource GlassCardGlowStyle}" />
                    <StackPanel Margin="20,16,20,16">
                        <TextBlock Text="设置与维护" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                        <TextBlock Margin="0,6,0,0" FontSize="13" LineHeight="21" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                   Text="集中管理转换输出、歌曲维护、AI 画像接口与运行环境。&#10;界面主题、壁纸和玻璃效果仍在顶部“主题”中调整；低频维护操作会在本页直接给出结果。" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 操作状态行 -->
            <Border Background="{DynamicResource ToolboxGlassCardBrush}"
                    BorderBrush="{DynamicResource ToolboxGlassCardBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14,9" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{DynamicResource SystemControlHighlightAccentBrush}" />
                    <TextBlock x:Name="StatusTextBlock" Grid.Column="1" Text="正在读取设置状态…"
                               Margin="10,0,0,0" FontSize="13" TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    <ProgressBar x:Name="BusyBar" Grid.Column="2" Width="84" Height="3" Margin="14,0,0,0"
                                 VerticalAlignment="Center" IsIndeterminate="True" Visibility="Collapsed" />
                </Grid>
            </Border>

            <Border x:Name="ErrorPanel" Visibility="Collapsed" CornerRadius="8" Padding="14,10" Margin="0,0,0,12"
                    Background="#26E76F51" BorderBrush="#59E76F51" BorderThickness="1">
                <TextBlock x:Name="ErrorTextBlock" FontSize="13" TextWrapping="Wrap"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
            </Border>

            <!-- 转换输出目录 -->
            <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,16">
                <Grid>
                    <Border Style="{StaticResource GlassCardGlowStyle}" />
                    <StackPanel Margin="20,18,20,18">
                        <TextBlock Text="转换输出目录" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Style="{StaticResource SectionHintStyle}"
                                   Text="转换后的音频与歌词保存位置。默认放在每首歌曲目录下的 unlock 文件夹；自定义目录会保留原有子目录。" />
                        <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                CornerRadius="6" Padding="12,8" Margin="0,14,0,0">
                            <TextBlock x:Name="OutputStatusText" Style="{StaticResource StatusTextStyle}"
                                       Text="正在读取输出目录…" />
                        </Border>
                        <WrapPanel Margin="0,12,0,0">
                            <Button x:Name="ChooseOutputButton" Content="选择输出目录"
                                    Style="{DynamicResource AccentButtonStyle}" Padding="16,6"
                                    Margin="0,0,8,8" Click="OnChooseOutputClick"
                                    ToolTip="选择转换音频和歌词的保存文件夹。" />
                            <Button x:Name="ResetOutputButton" Content="恢复默认" Padding="16,6"
                                    Margin="0,0,8,8" Click="OnResetOutputClick"
                                    ToolTip="恢复为每首歌曲目录下的 unlock 文件夹。" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 歌曲维护 -->
            <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,16">
                <Grid>
                    <Border Style="{StaticResource GlassCardGlowStyle}" />
                    <StackPanel Margin="20,18,20,18">
                        <TextBlock Text="歌曲维护" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Style="{StaticResource SectionHintStyle}"
                                   Text="扫描重复歌曲，先预览再决定；确认后移入工具箱回收站，可恢复。永久清理前请再次确认。" />
                        <WrapPanel Margin="0,14,0,0">
                            <Button x:Name="DedupeButton" Content="曲库安全去重" Padding="16,6"
                                    Margin="0,0,8,8" Click="OnDedupeClick"
                                    ToolTip="扫描、预览并确认后才把选中的重复文件移入工具箱回收站。" />
                            <Button x:Name="TrashButton" Content="工具箱回收站" Padding="16,6"
                                    Margin="0,0,8,8" Click="OnTrashClick"
                                    ToolTip="查看、恢复或永久清理由安全去重移入隔离目录的文件。" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- AI 画像 -->
            <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,16">
                <Grid>
                    <Border Style="{StaticResource GlassCardGlowStyle}" />
                    <StackPanel Margin="20,18,20,18">
                        <TextBlock Text="AI 画像" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Style="{StaticResource SectionHintStyle}"
                                   Text="配置 OpenAI 兼容接口、模型，以及所有歌曲和近30天新红心两份提示词。配置只保存在本机；保存后同步本地图表报告，不会主动调用 AI 接口。" />
                        <Button x:Name="PortraitAiButton" Content="AI 画像接口与提示词" Padding="16,6"
                                Margin="0,14,0,0" HorizontalAlignment="Left" Click="OnPortraitAiClick"
                                ToolTip="编辑接口地址、模型、API Key 与画像提示词。" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 运行环境 -->
            <Border Style="{StaticResource GlassCardStyle}">
                <Grid>
                    <Border Style="{StaticResource GlassCardGlowStyle}" />
                    <StackPanel Margin="20,18,20,18">
                        <TextBlock Text="运行环境" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Style="{StaticResource SectionHintStyle}"
                                   Text="桌面三行歌词与多人一起听需要兼容的网易云客户端目录。首次使用或换电脑时可先检查并配置随包运行环境。" />
                        <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                CornerRadius="6" Padding="12,8" Margin="0,14,0,0">
                            <TextBlock x:Name="ClientFolderText" Style="{StaticResource StatusTextStyle}"
                                       Text="正在读取网易云安装目录…" />
                        </Border>
                        <TextBlock Style="{StaticResource SectionHintStyle}" Margin="0,8,0,0"
                                   Text="三行歌词已验证网易云音乐 3.1.41 x64 Build 205529 与 3.1.42 x64 Build 205594；客户端更新后需要重新适配。" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button x:Name="ClientFolderButton" Content="网易云安装目录" Padding="16,6"
                                    Margin="0,0,8,8" Click="OnClientFolderClick"
                                    ToolTip="选择包含 cloudmusic.exe 的网易云音乐安装目录。" />
                            <Button x:Name="CheckEnvironmentButton" Content="检查运行环境"
                                    Style="{DynamicResource AccentButtonStyle}" Padding="16,6"
                                    Margin="0,0,8,8" Click="OnCheckEnvironmentClick"
                                    ToolTip="检查随包组件、Python、WebView2 与客户端目录，结果会显示在本页。" />
                            <Button x:Name="SetupEnvironmentButton" Content="配置登录运行环境" Padding="16,6"
                                    Margin="0,0,8,8" Click="OnSetupEnvironmentClick"
                                    ToolTip="检查并联网安装缺少的 WebView2 等运行组件。" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
