<UserControl x:Class="NeteaseToolbox.Wpf.ProfileDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:wf="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
             xmlns:local="clr-namespace:NeteaseToolbox.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1100">
    <UserControl.Resources>
        <!-- 分类占比条样式 -->
        <Style x:Key="FluentCapsuleProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="5" />
                            <Border x:Name="PART_Track" CornerRadius="5" ClipToBounds="True">
                                <Border x:Name="PART_Indicator" 
                                        Background="{TemplateBinding Foreground}" 
                                        HorizontalAlignment="Left" 
                                        CornerRadius="5" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 统计指标小卡片样式 -->
        <Style x:Key="MetricCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlStrokeColorCardStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18,14" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,20,28,32">
            <!-- 头部控制栏 -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="听歌画像仪表盘" FontSize="24" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                        <Border Margin="14,0,0,0" VerticalAlignment="Center" CornerRadius="4" 
                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Padding="8,3">
                            <TextBlock x:Name="AsOfTextBlock" Text="数据载入中…" FontSize="12" 
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="基于网易云官方听歌档案与本地百科标签分析，全本地实时计算。" 
                               Margin="0,4,0,0" FontSize="13" 
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 画像范围切换 -->
                    <Border CornerRadius="6" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Padding="3" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RadioScopeAll" Content="所有歌曲" IsChecked="True" 
                                         GroupName="PortraitScope" Style="{DynamicResource DefaultRadioButtonStyle}"
                                         Padding="10,4" Margin="2,0" Checked="OnScopeChanged" />
                            <RadioButton x:Name="RadioScopeRecent" Content="近30天红心" 
                                         GroupName="PortraitScope" Style="{DynamicResource DefaultRadioButtonStyle}"
                                         Padding="10,4" Margin="2,0" Checked="OnScopeChanged" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="RefreshAllButton" Content="刷新全部画像" 
                            Style="{DynamicResource AccentButtonStyle}"
                            Padding="16,6" Margin="0,0,8,0" Click="OnRefreshAllPortraitsClick" />
                    <Button x:Name="SyncProfileButton" Content="同步云端数据" 
                            Padding="14,6" Margin="0,0,8,0" Click="OnSyncProfileClick" />
                    <Button x:Name="OpenReportButton" Content="独立报告" 
                            Padding="12,6" Click="OnOpenExternalReportClick" />
                    <Button x:Name="PhoneSyncButton" Content="手机同步" 
                            Padding="12,6" Margin="8,0,0,0" Click="OnPhoneSyncClick" />
                </StackPanel>
            </Grid>

            <!-- 第一行：三张核心指标卡片 -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource MetricCardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="累计收录曲目" FontSize="13" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        <TextBlock x:Name="MetricTotalTracks" Text="--" FontSize="32" FontWeight="Bold" Margin="0,4,0,0"
                                   Foreground="{DynamicResource SystemControlHighlightAccentBrush}" />
                        <TextBlock Text="来自网易云红心与历史播放" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource MetricCardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="已标记曲风" FontSize="13" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        <TextBlock x:Name="MetricGenreCovered" Text="--" FontSize="32" FontWeight="Bold" Margin="0,4,0,0"
                                   Foreground="#2A9D8F" />
                        <TextBlock Text="具有歌曲百科曲风分类" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource MetricCardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="已标记情绪" FontSize="13" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        <TextBlock x:Name="MetricMoodCovered" Text="--" FontSize="32" FontWeight="Bold" Margin="0,4,0,0"
                                   Foreground="#E76F51" />
                        <TextBlock Text="具有情感色彩标签" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 第二行：原生分类占比区（通过 ItemsControl 动态渲染，完全可扩展语种、歌手等任意分类） -->
            <ItemsControl x:Name="CategoryGroupsControl" ItemsSource="{Binding CategoryGroups}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:TagCategoryGroup}">
                        <Border Style="{StaticResource MetricCardBorderStyle}" Margin="0,0,14,18">
                            <StackPanel>
                                <!-- 分类组卡片头部 -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" 
                                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                                        <TextBlock Text="{Binding Definition}" FontSize="12" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="4" 
                                            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Padding="8,4">
                                        <TextBlock Text="{Binding CoverageBadge}" FontSize="12" FontWeight="Medium" 
                                                   Foreground="{DynamicResource SystemControlHighlightAccentBrush}" />
                                    </Border>
                                </Grid>

                                <Separator Background="{DynamicResource SystemControlStrokeColorCardStrokeBrush}" Margin="0,0,0,10" />

                                <!-- 分类项条目列表 -->
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:TagShareItem}">
                                            <Grid Margin="0,4" ToolTip="{Binding ToolTipText}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="55" />
                                                    <ColumnDefinition Width="65" />
                                                </Grid.ColumnDefinitions>

                                                <!-- 标签名 -->
                                                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="13" 
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" 
                                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />

                                                <!-- 胶囊平滑占比进度条 -->
                                                <ProgressBar Grid.Column="1" Value="{Binding Share}" Minimum="0" Maximum="1" 
                                                             VerticalAlignment="Center" Style="{StaticResource FluentCapsuleProgressStyle}" />

                                                <!-- 占比百分比 -->
                                                <TextBlock Grid.Column="2" Text="{Binding ShareText}" FontSize="12" FontWeight="SemiBold" 
                                                           TextAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0"
                                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />

                                                <!-- 歌曲数 -->
                                                <TextBlock Grid.Column="3" Text="{Binding TrackCountText}" FontSize="12" 
                                                           TextAlignment="Right" VerticalAlignment="Center" 
                                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 第三行：对比与歌曲明细 Tabs -->
            <Border Style="{StaticResource MetricCardBorderStyle}" Margin="0,0,0,18" Padding="14">
                <TabControl Style="{DynamicResource DefaultTabControlStyle}">
                    <!-- 对比 Tab -->
                    <TabItem Header="近期与全局对比" FontSize="14" Padding="14,6">
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="比较近30天新增红心歌曲与历史全部歌曲在各曲风上的偏好迁移" 
                                       FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,10" />
                            <DataGrid x:Name="ComparisonDataGrid" AutoGenerateColumns="False" 
                                      CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      MaxHeight="360" VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="曲风标签" Binding="{Binding Genre}" Width="200" />
                                    <DataGridTextColumn Header="近期歌曲数" Binding="{Binding RecentCount}" Width="100" />
                                    <DataGridTextColumn Header="近期占比" Binding="{Binding RecentPct}" Width="100" />
                                    <DataGridTextColumn Header="全局歌曲数" Binding="{Binding GlobalCount}" Width="100" />
                                    <DataGridTextColumn Header="全局占比" Binding="{Binding GlobalPct}" Width="100" />
                                    <DataGridTemplateColumn Header="变化差值" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Delta}" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPositiveDelta}" Value="True">
                                                                    <Setter Property="Foreground" Value="#E76F51" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsPositiveDelta}" Value="False">
                                                                    <Setter Property="Foreground" Value="#2A9D8F" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </TabItem>

                    <!-- 歌曲明细 Tab -->
                    <TabItem Header="歌曲明细列表" FontSize="14" Padding="14,6">
                        <StackPanel Margin="0,12,0,0">
                            <!-- 快速搜索过滤框 -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="320" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SongSearchBox" Grid.Column="0" 
                                         ui:ControlHelper.PlaceholderText="搜索歌名、歌手或专辑…" 
                                         TextChanged="OnSongSearchTextChanged" />
                                <TextBlock x:Name="SongCountFilterText" Grid.Column="2" VerticalAlignment="Center" 
                                           FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            </Grid>

                            <!-- 高性能虚拟化表格 -->
                            <DataGrid x:Name="SongDetailsDataGrid" AutoGenerateColumns="False" 
                                      CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                                      MaxHeight="450" VerticalScrollBarVisibility="Auto"
                                      MouseDoubleClick="OnSongRowDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="歌曲标题" Binding="{Binding Title}" Width="220" />
                                    <DataGridTextColumn Header="歌手" Binding="{Binding Artist}" Width="160" />
                                    <DataGridTextColumn Header="专辑" Binding="{Binding Album}" Width="180" />
                                    <DataGridTextColumn Header="累计播放" Binding="{Binding PlayCount}" Width="90" />
                                    <DataGridTextColumn Header="首次收听" Binding="{Binding FirstListen}" Width="140" />
                                    <DataGridTextColumn Header="红心时间" Binding="{Binding LikedAt}" Width="140" />
                                    <DataGridTextColumn Header="歌曲 ID" Binding="{Binding SongId}" Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </TabItem>

                    <!-- 本机播放统计 Tab -->
                    <TabItem Header="本机播放统计" FontSize="14" Padding="14,6">
                        <wf:WindowsFormsHost x:Name="LocalPlaybackHost" Margin="0,12,0,0" Height="520" />
                    </TabItem>
                </TabControl>
            </Border>

            <!-- 第四行：AI 画像深度解读卡片 -->
            <Border Style="{StaticResource MetricCardBorderStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="AI 画像深度解读" FontSize="16" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                            <Border Margin="12,0,0,0" CornerRadius="4" 
                                    Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Padding="8,3">
                                <TextBlock x:Name="AiModelTextBlock" Text="{Binding AiInsight.Model, FallbackValue='未配置模型'}" 
                                           FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            </Border>
                        </StackPanel>
                        <Border Grid.Column="1" CornerRadius="4" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Padding="8,3">
                            <TextBlock x:Name="AiStatusTextBlock" Text="{Binding AiInsight.StatusText, FallbackValue='就绪'}" 
                                       FontSize="12" FontWeight="Medium" Foreground="{DynamicResource SystemControlHighlightAccentBrush}" />
                        </Border>
                    </Grid>
                    <Separator Background="{DynamicResource SystemControlStrokeColorCardStrokeBrush}" Margin="0,0,0,12" />
                    <TextBlock x:Name="AiContentTextBlock" 
                               Text="{Binding AiInsight.Content, FallbackValue='启用并配置 AI 后，刷新画像可生成深度性格与听歌品味解读。'}" 
                               FontSize="14" LineHeight="24" TextWrapping="Wrap" 
                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
